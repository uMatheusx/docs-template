# ------------------------------------------------------------------ Aplicação
SITE_NAME=Account Hub Docs
# Prévia de links (WhatsApp, Slack, Teams...): descrição padrão e endereço público do site
SITE_DESCRIPTION=Documentação do Account Hub
# PUBLIC_URL=https://docs.exemplo.com
APP_PORT=8000
# production = o backend se recusa a subir com senha/segredo padrão ou fracos
# (senhas com menos de 12 caracteres, JWT_SECRET com menos de 32); development só avisa
APP_ENV=development

# Usuário administrador (troque em qualquer ambiente compartilhado!)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Outros usuários do Studio: nome:senha:papel separados por vírgula.
# Papéis: admin (tudo) | editor (cria rascunhos; páginas publicadas só mudam via revisão)
# USERS=ana:troque-esta-senha:editor,bruno:outra-senha:admin
# true = o autor de uma proposta pode aprová-la (útil quando há um único admin)
REVIEW_SELF_APPROVAL=false
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_MINUTES=720
# true quando servido via HTTPS
COOKIE_SECURE=false
# false = exige login também para ler a documentação
PUBLIC_READ=true
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------ AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE=accounthub-docs-pages
S3_BUCKET=accounthub-docs

# Local (docker compose): credenciais quaisquer (DynamoDB Local e SeaweedFS não validam)
AWS_ACCESS_KEY_ID=accounthub
AWS_SECRET_ACCESS_KEY=accounthub-secret

# Endpoints locais (já definidos no docker-compose). Em produção deixe VAZIOS
# para usar os endpoints reais da AWS e as credenciais da role/IAM.
# DYNAMODB_ENDPOINT_URL=
# S3_ENDPOINT_URL=

# Cria tabela/bucket se não existirem e popula com páginas de exemplo
AUTO_CREATE_RESOURCES=true
SEED_ON_STARTUP=true
